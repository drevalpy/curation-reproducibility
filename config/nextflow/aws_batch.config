// Executor settings for fit_curves on AWS Batch (execution.backend: aws_batch).
// Passed to drevalpy/curate with -c; it decides where tasks run, never what they fit.
// The account-specific values come from the environment:
//   DATA_CURATION_AWS_QUEUE         Batch queue for the chunk fits (small instances suffice)
//   DATA_CURATION_AWS_LARGE_QUEUE   Batch queue for planning and collecting (16 GB and more);
//                                   defaults to DATA_CURATION_AWS_QUEUE
//   DATA_CURATION_AWS_WORKDIR       S3 work directory, e.g. s3://<bucket>/nextflow/work
// The region is the AWS SDK's (AWS_REGION, AWS_DEFAULT_REGION or the profile).

process {
    executor = 'awsbatch'
    // Every chunk is a single-core task with little memory.
    queue    = System.getenv('DATA_CURATION_AWS_QUEUE')
    // Planning and collecting hold the whole screen in memory (16 GB and more).
    withLabel: 'process_drevalpy_whole_screen' {
        queue = System.getenv('DATA_CURATION_AWS_LARGE_QUEUE') ?: System.getenv('DATA_CURATION_AWS_QUEUE')
    }
    // A retried chunk asks for more memory each attempt; keep it within an 8 GB instance.
    withLabel: 'process_drevalpy_chunk' {
        resourceLimits = [ cpus: 2, memory: 7.GB ]
    }
}

aws {
    // Spot instances can be reclaimed; retry such a task a few times before failing it.
    batch.maxSpotAttempts = 3
}

workDir = System.getenv('DATA_CURATION_AWS_WORKDIR')

docker.enabled = true

// The pipeline container holds no AWS CLI and the compute environment's AMI has none a container
// can use, so Fusion moves task files between S3 and the task. Wave adds Fusion to the public
// pipeline container (ghcr.io/drevalpy/curate) at launch.
fusion.enabled = true
wave.enabled   = true

// Batch queues jobs itself; let many chunks be submitted at once.
executor {
    queueSize = 500
}
