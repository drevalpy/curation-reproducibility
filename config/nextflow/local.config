// Executor settings for fit_curves on this machine (execution.backend: local).
// Passed to drevalpy/curate with -c; it decides where tasks run, never what they fit.

process.executor = 'local'

// Every task runs in the pipeline container, as the user so its outputs are not root-owned.
docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
}

// One chunk is a single-core task: run 4 at once. The host has 16 GB and earlyoom kills above
// 85%, so cap memory below that; planning and collecting request 16 GB on other executors.
executor {
    cpus   = 4
    memory = '12 GB'
}
process.resourceLimits = [cpus: 4, memory: 12.GB]
