// Executor settings for fit_curves on SLURM (execution.backend: slurm).
// Passed to drevalpy/curate with -c; it decides where tasks run, never what they fit.

// shared-cpu is the partition the old submitit backend used; chunks are single-core.
process {
    executor = 'slurm'
    queue    = 'shared-cpu'
}

// Compute nodes have Apptainer/Singularity, not Docker; autoMounts makes the input paths visible.
apptainer {
    enabled    = true
    autoMounts = true
}
singularity {
    enabled    = true
    autoMounts = true
}

// At most 64 jobs queued at once, as with the old backend, to stay a fair user of the partition.
executor {
    queueSize = 64
}
