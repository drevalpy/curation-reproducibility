# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tool caches
.pytest_cache/
.ruff_cache/
.complexipy_cache/

# DVC outputs: the numbered step directories (see src/data_curation/core/layout.py).
# Everything in them is ignored except the .dvc files of `dvc add`-tracked inputs
# (data/01_raw/gdsc/<kind>.dvc), so git still has to descend into the directories.
/data/0*/**
!/data/0*/**/
!/data/0*/**/*.dvc

# Chunk-level curve fitting cache (content-addressed, auto-populated)
/data/cache/

# macOS
.DS_Store

slurm_logs/

# marimo session caches, written next to a notebook whenever it runs
__marimo__/
